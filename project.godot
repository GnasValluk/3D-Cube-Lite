; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tila'Adventure"
run/main_scene="res://scenes/start_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.06, 0.06, 0.1, 1)
config/icon="res://icon.svg"

[autoload]

WorldSeed="*res://scripts/core/world_seed.gd"
SaveManager="*res://scripts/core/save_manager.gd"
DeviceManager="*res://scripts/core/device_manager.gd"
TimeSystem="*res://scripts/core/time_system.gd"
SFXManager="*res://scripts/audio/sfx_manager.gd"
CollisionQueue="*res://scripts/core/collision_queue.gd"
WaterRebuildQueue="*res://scripts/core/water_rebuild_queue.gd"
SettingsData="*res://scripts/core/settings_manager.gd"
Net="*res://scripts/core/network_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/game_font.tres"

